<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolVoting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --lemon-green: #3ecf8e;
            --bg-body: #050505;
            --bg-card: #111111;
            --text-main: #ffffff;
            --text-muted: #a0a0a0;
            --border-subtle: #222222;
            --input-bg: #1a1a1a;
            --navbar-height: 70px;
        }

        [data-bs-theme="light"] {
            --bg-body: #f4f7f6;
            --bg-card: #ffffff;
            --text-main: #1a1d21;
            --text-muted: #626973;
            --border-subtle: #e0e4e8;
            --input-bg: #ffffff;
        }

        body { 
            background-color: var(--bg-body); 
            color: var(--text-main); 
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            transition: background-color 0.3s ease;
        }

        /* --- TOP BAR STYLE --- */
        .navbar { 
            height: var(--navbar-height);
            background-color: var(--bg-card);
            border-bottom: 1px solid var(--border-subtle);
            z-index: 1030;
        }

        /* --- GLOBAL UI COMPONENTS --- */
        .theme-card, .card {
            background-color: var(--bg-card) !important;
            border: 1px solid var(--border-subtle) !important;
            color: var(--text-main) !important;
            border-radius: 12px;
        }

        .form-control, .form-select {
            background-color: var(--input-bg) !important;
            color: var(--text-main) !important;
            border: 1px solid var(--border-subtle) !important;
        }

        .form-control:focus {
            border-color: var(--lemon-green) !important;
            box-shadow: 0 0 0 0.25rem rgba(62, 207, 142, 0.2);
        }

        /* --- LOADER --- */
        #global-loader {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: var(--bg-body); z-index: 9999;
            transition: opacity 0.4s ease, visibility 0.4s ease;
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border-subtle); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--lemon-green); }
    </style>
</head>
<body>

    @* 1. THE LOADER *@
    <div id="global-loader" class="d-flex align-items-center justify-content-center">
        <div class="text-center">
            <div class="spinner-border" style="width: 3rem; height: 3rem; color: var(--lemon-green);" role="status"></div>
            <p class="mt-3 fw-bold text-muted small text-uppercase" style="letter-spacing: 2px;">Syncing LAN Terminals...</p>
        </div>
    </div>

    @* 2. THE TOP BAR *@
    <header class="sticky-top">
        <nav class="navbar px-4 d-flex justify-content-between align-items-center">
            @* Brand *@
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-shield-lock-fill me-2 text-success"></i> VOTING COMMAND
            </a>

            @* Right Side Items *@
            <div class="d-flex align-items-center gap-4">
                <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-3 py-2">
                    <i class="bi bi-broadcast me-1"></i> HUB: 192.168.1.5
                </span>
                
                @* Theme Switcher *@
                <div class="dropdown">
                    <button class="btn btn-link nav-link dropdown-toggle p-0" id="bd-theme" data-bs-toggle="dropdown">
                        <i class="bi bi-circle-half fs-5"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><button class="dropdown-item d-flex align-items-center" data-bs-theme-value="light"><i class="bi bi-sun-fill me-2"></i> Light</button></li>
                        <li><button class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark"><i class="bi bi-moon-stars-fill me-2"></i> Dark</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><button class="dropdown-item d-flex align-items-center" data-bs-theme-value="auto"><i class="bi bi-laptop me-2"></i> System</button></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* 3. THE CONTENT INJECTION POINT *@
    <div class="container-fluid p-0">
        @RenderBody()
    </div>

    @* 4. CORE SCRIPTS *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Smooth Loader Logic
        window.addEventListener('load', () => {
            const loader = document.getElementById('global-loader');
            loader.style.opacity = '0';
            setTimeout(() => { loader.style.visibility = 'hidden'; }, 400);
        });

        // Theme Persistence & Logic
        const getStoredTheme = () => localStorage.getItem('theme');
        const setStoredTheme = theme => localStorage.setItem('theme', theme);

        const getPreferredTheme = () => {
            const storedTheme = getStoredTheme();
            if (storedTheme) return storedTheme;
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };

        const setTheme = theme => {
            if (theme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            } else {
                document.documentElement.setAttribute('data-bs-theme', theme);
            }
        };

        setTheme(getPreferredTheme());

        document.querySelectorAll('[data-bs-theme-value]').forEach(toggle => {
            toggle.addEventListener('click', () => {
                const theme = toggle.getAttribute('data-bs-theme-value');
                setStoredTheme(theme);
                setTheme(theme);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>