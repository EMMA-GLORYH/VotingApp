@{
    // Helper to determine if a link should be marked as "active"
    string IsActive(string action) => 
        ViewContext.RouteData.Values["Action"]?.ToString() == action ? "active" : "";
    
    // Helper to determine if a collapse menu should be "show" based on the current action
    string IsExpanded(params string[] actions) => 
        actions.Contains(ViewContext.RouteData.Values["Action"]?.ToString()) ? "show" : "";
}

<div class="pt-4 px-3 d-flex flex-column h-100 sidebar-container">
    <div class="text-center mb-4">
        <div class="brand-icon-wrapper mb-2">
            <i class="bi bi-shield-check-fill text-success" style="font-size: 2.2rem;"></i>
        </div>
        <h6 class="fw-bold small text-uppercase mb-0 tracking-widest">Admin Hub</h6>
        <div class="badge bg-success-subtle text-success mt-2 py-2 px-3 border border-success border-opacity-10">
            <span class="spinner-grow spinner-grow-sm me-2" style="width: 6px; height: 6px;"></span>
            <span class="x-small fw-bold">SYSTEM ONLINE</span>
        </div>
    </div>

    <hr class="border-secondary opacity-10 mb-3">

    <div class="flex-grow-1 overflow-auto custom-scrollbar">
        <ul class="nav flex-column gap-1" id="adminMenu">
            <li class="nav-item">
                <a class="nav-link @IsActive("Dashboard")" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-speedometer2 me-3"></i> Overview
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center @(IsExpanded("VoterTokenHub") == "" ? "collapsed" : "")" 
                   data-bs-toggle="collapse" href="#voterMenu">
                    <span><i class="bi bi-people me-3"></i> Voter Control</span>
                    <i class="bi bi-chevron-down small transition-icon"></i>
                </a>
                <div class="collapse @IsExpanded("VoterTokenHub")" id="voterMenu" data-bs-parent="#adminMenu">
                    <ul class="nav flex-column ms-4 mt-1 small border-start border-secondary border-opacity-25">
                        <li>
                            <a class="nav-link py-2 ps-3 @IsActive("VoterTokenHub")" asp-controller="Admin" asp-action="VoterTokenHub">
                                Voter Registry
                            </a>
                        </li>
                        <li><a class="nav-link py-2 ps-3" href="#">Token Vault</a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center @(IsExpanded("ElectionManager") == "" ? "collapsed" : "")" 
                   data-bs-toggle="collapse" href="#electionMenu">
                    <span><i class="bi bi-clipboard-data me-3"></i> Election Setup</span>
                    <i class="bi bi-chevron-down small transition-icon"></i>
                </a>
                <div class="collapse @IsExpanded("ElectionManager")" id="electionMenu" data-bs-parent="#adminMenu">
                    <ul class="nav flex-column ms-4 mt-1 small border-start border-secondary border-opacity-25">
                        <li>
                            <a class="nav-link py-2 ps-3 @IsActive("ElectionManager")" asp-controller="Admin" asp-action="ElectionManager">
                                Manage Positions
                            </a>
                        </li>
                        <li><a class="nav-link py-2 ps-3" href="#">Candidate Profiles</a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a class="nav-link @IsActive("NetworkTerminals")" asp-controller="Admin" asp-action="NetworkTerminals">
                    <i class="bi bi-pc-display me-3"></i> LAN Monitor
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @IsActive("SecurityVault")" asp-controller="Admin" asp-action="SecurityVault">
                    <i class="bi bi-safe2 me-3"></i> Security Vault
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @IsActive("SystemConfig")" asp-controller="Admin" asp-action="SystemConfig">
                    <i class="bi bi-gear me-3"></i> System Config
                </a>
            </li>
        </ul>
    </div>

    <div class="pb-4 mt-auto border-top border-secondary border-opacity-10 pt-4">
        <button class="btn btn-sm btn-outline-danger w-100 rounded-pill mb-3 fw-bold emergency-btn shadow-sm">
            <i class="bi bi-stop-circle me-2"></i> EMERGENCY STOP
        </button>
        <div class="text-center">
            <code class="text-muted" style="font-size: 10px; font-family: 'JetBrains Mono', monospace;">NODE_ID: 192.168.1.5</code>
        </div>
    </div>
</div>

<style>
    .nav-link { 
        padding: 0.8rem 1.2rem; 
        border-radius: 10px; 
        color: var(--text-muted) !important; 
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); 
        font-size: 0.92rem; 
        border: 1px solid transparent;
        display: flex;
        align-items: center;
    }
    .nav-link:hover { 
        background: rgba(62, 207, 142, 0.08); 
        color: var(--lemon-green) !important; 
        transform: translateX(4px);
    }
    .nav-link.active { 
        background: var(--lemon-green) !important; 
        color: #050505 !important; 
        font-weight: 700; 
        box-shadow: 0 4px 12px rgba(62, 207, 142, 0.2);
    }
    .collapse .nav-link { border-radius: 0 8px 8px 0; margin-left: -1px; }
    .collapse .nav-link.active {
        background: rgba(62, 207, 142, 0.15) !important;
        color: var(--lemon-green) !important;
        border-left: 2px solid var(--lemon-green);
        box-shadow: none;
    }
    .transition-icon { transition: transform 0.3s ease; }
    .nav-link:not(.collapsed) .transition-icon { transform: rotate(180deg); }
    .emergency-btn:hover {
        background-color: #dc3545;
        color: white;
        box-shadow: 0 0 15px rgba(220, 53, 69, 0.4);
    }
    .custom-scrollbar::-webkit-scrollbar { width: 0; }
    .tracking-widest { letter-spacing: 2px; }
    .x-small { font-size: 0.7rem; }
</style>