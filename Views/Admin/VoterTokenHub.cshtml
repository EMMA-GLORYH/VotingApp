@model IEnumerable<SchoolVotingApp.Controllers.Voter>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Voter Registry";
}

<div class="row g-0">
    <aside class="col-md-3 col-lg-2 sidebar-wrapper d-none d-md-block border-end">
        @Html.Partial("_AdminSidebar")
    </aside>

    <main class="col-md-9 col-lg-10 content-scrollable px-md-4 py-4">
        
        @* --- TOP SEARCH BAR --- *@
        <div class="row mb-4">
            <div class="col-12">
                <div class="input-group input-group-lg shadow-sm border-0">
                    <span class="input-group-text border-end-0 text-muted ps-4 search-icon-bg">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="voterSearch" class="form-control border-start-0 py-3 fw-medium search-input-bg" 
                           placeholder="Search by Student Name, ID, or Class..." style="font-size: 1rem; border-radius: 0 12px 12px 0;">
                </div>
            </div>
        </div>

        @* --- Header & Actions --- *@
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-0">Voter <span style="color: var(--lemon-green);">Registry</span></h2>
                <p class="text-muted small mb-0">Live Overview of @Model.Count() Enrolled Students</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-green shadow-sm px-4 fw-bold text-dark" onclick="openEnrollModal()">
                    <i class="bi bi-person-plus-fill me-2"></i> ENROLL STUDENT
                </button>
                <button class="btn btn-outline-secondary shadow-sm px-3" data-bs-toggle="modal" data-bs-target="#importModal">
                    <i class="bi bi-file-earmark-arrow-up"></i>
                </button>
            </div>
        </div>

        @* --- Stats Grid --- *@
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card theme-card p-3 shadow-sm border-0">
                    <small class="text-muted fw-bold">TOTAL</small>
                    <h3 class="fw-bold m-0 text-body">@Model.Count()</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card theme-card p-3 shadow-sm border-0">
                    <small class="text-success fw-bold">CANDIDATES</small>
                    <h3 class="fw-bold m-0 text-success">@Model.Count(v => v.IsCandidate)</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card theme-card p-3 shadow-sm border-0">
                    <small class="text-primary fw-bold">VOTED</small>
                    <h3 class="fw-bold m-0 text-primary">@Model.Count(v => v.HasVoted)</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card theme-card p-3 shadow-sm border-0">
                    <small class="text-danger fw-bold">INACTIVE</small>
                    <h3 class="fw-bold m-0 text-danger">@Model.Count(v => !v.IsActive)</h3>
                </div>
            </div>
        </div>

        @* --- Main Voter Table --- *@
        <div class="card theme-card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0" id="voterTable">
                    <thead class="small text-uppercase opacity-75">
                        <tr class="table-light-header">
                            <th class="ps-4 py-3">Student ID</th>
                            <th>Name & Class</th>
                            <th>Identity</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var voter in Model)
                        {
                            <tr class="@(voter.IsActive ? "" : "opacity-50")">
                                <td class="ps-4 fw-bold text-success font-monospace">@voter.StudentId</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(voter.ProfileImage) ? "/img/default-avatar.png" : voter.ProfileImage)" 
                                             class="rounded-circle me-3 border" 
                                             style="width: 38px; height: 38px; object-fit: cover; border-color: var(--bs-border-color) !important;">
                                        <div>
                                            <div class="fw-semibold text-body">@voter.FullName</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@voter.VoterClass</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-body">
                                    <i class="bi @(voter.Gender == "Male" ? "bi-gender-male text-info" : "bi-gender-female text-danger") me-1"></i>
                                    @voter.Gender
                                </td>
                                <td>
                                    @if (voter.IsCandidate) { <span class="badge bg-warning text-dark me-1">CANDIDATE</span> }
                                    <span class="badge rounded-pill @(voter.HasVoted ? "bg-primary" : "bg-success")">
                                        @(voter.HasVoted ? "Voted" : (voter.IsActive ? "Active" : "Disabled"))
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-action me-1" 
                                            onclick="openEditModal('@voter.StudentId', '@Html.Raw(voter.FullName)', '@voter.VoterClass', '@voter.Gender', '@voter.IsCandidate.ToString().ToLower()', '@voter.ProfileImage')">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@voter.StudentId" />
                                        <button type="submit" class="btn btn-sm btn-action @(voter.IsActive ? "text-danger" : "text-success")">
                                            <i class="bi @(voter.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

@* --- MODAL: ENROLL & EDIT --- *@
<div class="modal fade" id="voterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content theme-card border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mt-2 ps-2 text-body" id="modalTitle">Enroll New Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form id="voterForm" action="" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="voterStudentId" name="student_id">
                    
                    @* --- Image Upload Section --- *@
                    <div class="mb-4 text-center">
                        <div class="position-relative d-inline-block">
                            <img id="imagePreview" src="/img/default-avatar.png" 
                                 class="rounded-circle border border-2 border-dashed p-1" 
                                 style="width: 100px; height: 100px; object-fit: cover; border-color: var(--lemon-green) !important;">
                            <label for="profile_image" class="btn btn-sm btn-green rounded-circle position-absolute bottom-0 end-0 shadow">
                                <i class="bi bi-camera-fill text-dark"></i>
                            </label>
                            <input type="file" id="profile_image" name="profile_image" class="d-none" accept="image/*" onchange="previewImage(this)">
                        </div>
                        <p class="small text-muted mt-2 mb-0">Profile Photo (Optional)</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">FULL NAME</label>
                        <input type="text" id="voterFullName" name="full_name" class="form-control form-control-lg theme-input" required>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">CLASS</label>
                            <select id="voterClass" name="voter_class" class="form-select theme-input">
                                <optgroup label="Junior High">
                                    <option value="JHS 1">JHS 1</option>
                                    <option value="JHS 2">JHS 2</option>
                                    <option value="JHS 3">JHS 3</option>
                                </optgroup>
                                <optgroup label="Primary School">
                                    <option value="PRIMARY 1">PRIMARY 1</option>
                                    <option value="PRIMARY 2">PRIMARY 2</option>
                                    <option value="PRIMARY 3">PRIMARY 3</option>
                                    <option value="PRIMARY 4">PRIMARY 4</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">GENDER</label>
                            <select id="voterGender" name="gender" class="form-select theme-input">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-check form-switch p-3 rounded-3 border text-body" style="border-color: var(--bs-border-color) !important;">
                        <input class="form-check-input ms-0 me-3" type="checkbox" name="is_candidate" value="true" id="voterIsCandidate">
                        <label class="form-check-label fw-bold" for="voterIsCandidate">Register as Candidate</label>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-action px-4 fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-green px-5 fw-bold shadow-sm text-dark" id="submitBtn">Save Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* --- MODAL: BULK IMPORT --- *@
<div class="modal fade" id="importModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content theme-card border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold mt-2 ps-2 text-body">Bulk Enrollment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ImportVoters" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="p-3 rounded-3 mb-4" style="background-color: rgba(62, 207, 142, 0.1); border: 1px dashed var(--lemon-green);">
                        <p class="small mb-0 text-body">
                            <i class="bi bi-info-circle-fill me-2 text-success"></i>
                            Upload a <strong>.csv</strong> file with these columns in order:<br>
                            <span class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">FullName, Class, Gender, IsCandidate(1 or 0)</span>
                        </p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">SELECT CSV FILE</label>
                        <input type="file" name="csvFile" class="form-control theme-input" accept=".csv" required>
                    </div>

                    <div class="text-center mt-3">
                        <a href="/templates/voter_template.csv" class="text-decoration-none small fw-bold" style="color: var(--lemon-green);">
                            <i class="bi bi-download me-1"></i> Download CSV Template
                        </a>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-action px-4 fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-green px-5 fw-bold shadow-sm text-dark">Upload & Enroll</button>
                </div>
            </form>
        </div>
    </div>
</div>
<style>
    :root { 
        --lemon-green: #3ECF8E; 
    }

    /* Fixed Sidebar Logic */
    .sidebar-wrapper { 
        background-color: var(--bs-body-bg); 
        z-index: 100; 
        height: 100vh; 
        position: sticky; /* Keeps it locked to the top */
        top: 0;
        overflow-y: auto; /* Allows the sidebar itself to scroll if the menu is long */
    }

    /* Content Area */
    .content-scrollable { 
        background-color: var(--bs-tertiary-bg); 
        min-height: 100vh; /* Ensure it fills the screen */
    }
    
    /* Removed height: 100vh from content-scrollable to allow the main body scrollbar 
       to handle the scrolling, which is smoother for most browsers */

    .search-icon-bg, .search-input-bg { 
        background-color: var(--bs-body-bg) !important; 
        color: var(--bs-body-color) !important;
        border-color: var(--bs-border-color) !important;
    }

    .theme-card { 
        border-radius: 16px; 
        background-color: var(--bs-body-bg); 
        border: 1px solid var(--bs-border-color-translucent); 
    }

    .table-light-header { background-color: var(--bs-tertiary-bg); }

    .btn-green { background-color: var(--lemon-green); color: #000; transition: all 0.3s; border: none; }
    .btn-green:hover { background-color: #34b37a; transform: translateY(-2px); color: #000; }
    
    .btn-action { 
        background-color: var(--bs-tertiary-bg); 
        border: 1px solid var(--bs-border-color);
        color: var(--bs-body-color);
    }
    .btn-action:hover { background-color: var(--bs-secondary-bg); }

    .table-hover tbody tr:hover { 
        background-color: rgba(62, 207, 142, 0.05) !important; 
    }

    .theme-input {
        background-color: var(--bs-tertiary-bg) !important;
        color: var(--bs-body-color) !important;
        border: 1px solid var(--bs-border-color) !important;
    }
    
    .theme-input:focus {
        background-color: var(--bs-body-bg) !important;
        border-color: var(--lemon-green) !important;
        box-shadow: 0 0 0 0.25rem rgba(62, 207, 142, 0.25) !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        
        const modalElement = document.getElementById('voterModal');
        if (typeof bootstrap !== 'undefined' && modalElement) {
            window.voterModalObj = new bootstrap.Modal(modalElement);
        }

        window.previewImage = function(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        };

        window.openEnrollModal = function() {
            const form = document.getElementById('voterForm');
            const modalTitle = document.getElementById('modalTitle');
            const studentIdInput = document.getElementById('voterStudentId');
            const submitBtn = document.getElementById('submitBtn');

            modalTitle.innerText = "Enroll New Student";
            submitBtn.innerText = "Save Student";
            form.action = "/Admin/AddVoter";
            
            form.reset();
            studentIdInput.value = "";
            document.getElementById('imagePreview').src = "/img/default-avatar.png";

            window.voterModalObj.show();
        };

        window.openEditModal = function(id, name, vClass, gender, isCand, imgPath) {
            const form = document.getElementById('voterForm');
            const modalTitle = document.getElementById('modalTitle');
            const submitBtn = document.getElementById('submitBtn');

            modalTitle.innerText = "Edit Student Record";
            submitBtn.innerText = "Update Record";
            form.action = "/Admin/EditVoter";

            document.getElementById('voterStudentId').value = id;
            document.getElementById('voterFullName').value = name;
            document.getElementById('voterClass').value = vClass;
            document.getElementById('voterGender').value = gender;
            document.getElementById('voterIsCandidate').checked = (isCand === 'true');
            
            // Set image preview
            const preview = document.getElementById('imagePreview');
            preview.src = (imgPath && imgPath !== 'null' && imgPath !== '') ? imgPath : "/img/default-avatar.png";

            window.voterModalObj.show();
        };

        const searchInput = document.getElementById('voterSearch');
        if (searchInput) {
            searchInput.addEventListener('keyup', function () {
                const searchTerm = this.value.toLowerCase().trim();
                const tableBody = document.querySelector('#voterTable tbody');
                const rows = tableBody.querySelectorAll('tr:not(.no-results-row)');
                let hasVisibleRows = false;

                rows.forEach(row => {
                    const rowText = row.textContent.toLowerCase();
                    if (rowText.includes(searchTerm)) {
                        row.style.setProperty('display', '', 'important');
                        hasVisibleRows = true;
                    } else {
                        row.style.setProperty('display', 'none', 'important');
                    }
                });

                let noResultsMsg = document.getElementById('noResultsRow');
                if (!hasVisibleRows && searchTerm !== "") {
                    if (!noResultsMsg) {
                        const newRow = document.createElement('tr');
                        newRow.id = 'noResultsRow';
                        newRow.className = 'no-results-row';
                        newRow.innerHTML = `<td colspan="5" class="text-center py-5 text-muted">
                                                <i class="bi bi-search mb-2 d-block" style="font-size: 2rem; opacity: 0.3;"></i>
                                                No students found matching "<strong>${this.value}</strong>"
                                            </td>`;
                        tableBody.appendChild(newRow);
                    }
                } else if (noResultsMsg) {
                    noResultsMsg.remove();
                }
            });
        }
    });
</script>