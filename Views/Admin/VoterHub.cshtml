@{
    Layout = "_Layout";
    ViewData["Title"] = "Voter & Token Management";
}

<div class="row g-0">
    @Html.Partial("_AdminSidebar")

    <main class="col-md-9 ms-sm-auto col-lg-10 content-scrollable px-md-4 py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary border-opacity-20 pb-3">
            <h2 class="fw-bold">Voter <span style="color: var(--lemon-green);">Registry</span></h2>
            <div class="btn-group shadow-sm">
                <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#importModal">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i> Import CSV
                </button>
                <button class="btn btn-sm btn-green px-3" data-bs-toggle="modal" data-bs-target="#tokenModal">
                    <i class="bi bi-ticket-perforated me-1"></i> Generate Tokens
                </button>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card p-3 shadow-sm border-0">
                    <small class="text-muted fw-bold">TOTAL REGISTERED</small>
                    <h3 class="fw-bold m-0">1,250</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 shadow-sm border-0">
                    <small class="text-muted fw-bold text-success">TOKENS GENERATED</small>
                    <h3 class="fw-bold m-0 text-success">850</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="col-md-4 card p-3 shadow-sm border-0">
                    <small class="text-muted fw-bold text-warning">PENDING DISTRIBUTION</small>
                    <h3 class="fw-bold m-0 text-warning">400</h3>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead class="bg-dark text-muted small">
                        <tr>
                            <th class="ps-4">STUDENT ID</th>
                            <th>FULL NAME</th>
                            <th>CLASS</th>
                            <th>STATUS</th>
                            <th>TOKEN</th>
                            <th class="text-end pe-4">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        <tr>
                            <td class="ps-4 fw-bold">STU-2026-001</td>
                            <td>Emmanuel Darko</td>
                            <td>Form 3 Science</td>
                            <td><span class="badge bg-success-subtle text-success">Active</span></td>
                            <td><code>88219</code></td>
                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-link text-muted"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-link text-danger"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                        </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">Bulk Voter Import</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ImportVoters" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <p class="small text-muted">Upload a CSV file with headers: <code>StudentID, FullName, Class</code></p>
                    <input type="file" name="csvFile" class="form-control mb-3" accept=".csv" required />
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-green w-100">Upload & Process</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    @@keyframes fadeInBody {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .content-scrollable { animation: fadeInBody 0.6s ease-out; }
    code { color: var(--lemon-green); font-weight: bold; background: rgba(62, 207, 142, 0.1); padding: 2px 5px; border-radius: 4px; }
</style>