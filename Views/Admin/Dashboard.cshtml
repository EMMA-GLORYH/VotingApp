@{
    Layout = "_Layout";
    ViewData["Title"] = "Command Center";
}

<div class="row g-0">
    @* SIDEBAR COLUMN *@
    <aside class="col-md-3 col-lg-2 sidebar-wrapper d-none d-md-block">
        @Html.Partial("_AdminSidebar")
    </aside>

    @* MAIN CONTENT COLUMN *@
    <main class="col-md-9 col-lg-10 content-scrollable px-md-4 py-4">
        
        @* Header *@
        <div class="d-flex justify-content-between align-items-end pb-3 mb-4 border-bottom border-secondary border-opacity-20">
            <div>
                <h2 class="fw-bold mb-0">System <span style="color: var(--lemon-green);">Intelligence</span></h2>
                <p class="text-muted small mb-0">Real-time telemetry for Local Voting Terminals</p>
            </div>
            <button class="btn btn-sm btn-outline-success rounded-pill px-4" onclick="runSim()">RUN SIMULATION</button>
        </div>

        @* Telemetry Tiles *@
        <div class="row g-3 mb-5">
            <div class="col-md-3">
                <div class="card theme-card border-0 p-3 shadow-sm text-center">
                    <span class="text-muted small fw-bold">TURNOUT</span>
                    <h2 class="fw-bold text-success mb-0" id="stat-turnout">74.2%</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card theme-card border-0 p-3 shadow-sm text-center">
                    <span class="text-muted small fw-bold">ACTIVE PC'S</span>
                    <h2 class="fw-bold text-info mb-0">12 / 15</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card theme-card border-0 p-3 shadow-sm text-center">
                    <span class="text-muted small fw-bold">DB STATUS</span>
                    <h2 class="fw-bold text-primary mb-0">SYNCED</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card theme-card border-0 p-3 shadow-sm text-center">
                    <span class="text-muted small fw-bold">TOKENS LEFT</span>
                    <h2 class="fw-bold text-warning mb-0">402</h2>
                </div>
            </div>
        </div>

        @* Table Monitor *@
        <div class="card theme-card border-0 shadow-sm mb-5">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between">
                <h5 class="fw-bold mb-0"><i class="bi bi-broadcast text-success me-2"></i>LAN Terminal Monitor</h5>
                <span class="badge bg-dark text-success border border-success border-opacity-25">@ViewBag.ServerStatus</span>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table mb-0">
                        <thead class="text-muted small text-uppercase">
                            <tr>
                                <th>Terminal</th>
                                <th>IP Address</th>
                                <th>Status</th>
                                <th>Active Voter</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for(int i=1; i<=8; i++) {
                                <tr>
                                    <td class="fw-bold">PC-@(i < 10 ? "0"+i : i)</td>
                                    <td class="font-monospace opacity-75">192.168.1.@(100+i)</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="spinner-grow spinner-grow-sm text-success me-2" style="width: 8px; height: 8px;"></span>
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        </div>
                                    </td>
                                    <td class="font-monospace small">STU-@(800+i)</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-dark border-secondary px-3" style="font-size: 0.7rem;">RESET</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* Placeholder *@
        <div class="card theme-card border-0 p-4 mb-5 text-center border-dashed">
            <h5 class="text-muted opacity-50 fw-light">
                <i class="bi bi-bar-chart-fill me-2"></i>Result Aggregator Module Standby...
            </h5>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        function runSim() {
            console.log("Telemetry simulation started on Node: 192.168.1.5");
        }
    </script>
}

<style>
    .sidebar-wrapper {
        background-color: var(--bg-card);
        border-right: 1px solid var(--border-subtle);
        height: calc(100vh - 70px);
        position: sticky;
        top: 0;
    }
    .content-scrollable {
        height: calc(100vh - 70px); 
        overflow-y: auto;
    }
    .theme-card { border-radius: 12px; }
    .custom-table { color: var(--text-main); }
    .custom-table td, .custom-table th { 
        border-bottom: 1px solid var(--border-subtle); 
        padding: 1rem 0.75rem;
    }
    .border-dashed {
        border: 2px dashed var(--border-subtle) !important;
        background: transparent !important;
    }
</style>